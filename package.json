{
  "name": "llm-redaction-gateway",
  "private": true,
  "version": "0.1.0",
  "description": "Local prompt redaction and sample policy-decision prototype; no provider forwarding or live audit writes.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --require ts-node/register --test --test-concurrency=1 tests/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "llm-security",
    "pii-redaction",
    "data-loss-prevention",
    "ai-governance",
    "ciso-tooling",
    "redaction-gateway",
    "platform-engineering"
  ],
  "author": "Mirza Causevic <miz@kineticgain.dev>",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
